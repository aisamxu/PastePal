	<string>PastePal needs this permission to paste clippings into other applications and to add itself to Login Items.</string>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright © 2026 PastePal contributors. Based on Flycut and Jumpcut.</string>
	<key>NSMainNibFile</key>
	<string>MainMenu</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSSupportsAutomaticGraphicsSwitching</key>
	<true/>
